# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-string
SITE_BASE_URL=http://127.0.0.1:8000

# Razorpay (Test Mode — https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email (Gmail SMTP — requires an App Password, not your normal password)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key


# WhatsApp Cloud API (Meta Developer App — https://developers.facebook.com/apps) [note, this takes a while to get an approval of the template from META]
WHATSAPP_ACCESS_TOKEN=your_meta_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_test_number_id
